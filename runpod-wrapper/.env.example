RUNPOD_HMAC_SECRET_CURRENT=replace-with-strong-random-secret
RUNPOD_HMAC_SECRET_PREVIOUS=

VPS_HMAC_SECRET_CURRENT=replace-with-strong-random-secret
VPS_HMAC_SECRET_PREVIOUS=

# Comma-separated list. Supports exact host and wildcard prefix (*.example.com).
CALLBACK_ALLOWED_HOSTS=api.example.com

# Keep false in production. Set true only for local/dev callback testing over HTTP.
ALLOW_INSECURE_CALLBACK_HTTP=false

# Optional if VieNeu-TTS is not at ../VieNeu-TTS
# VIENEU_TTS_PATH=/path/to/VieNeu-TTS
