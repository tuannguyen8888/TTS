# Path inside container where VieNeu-TTS source/package is available
VIENEU_TTS_PATH=/workspace/VieNeu-TTS

# VieNeu model config (demo defaults)
VIENEU_MODE=standard
VIENEU_BACKBONE_REPO=pnnbao-ump/VieNeu-TTS-0.3B-q4-gguf
VIENEU_BACKBONE_DEVICE=gpu
VIENEU_CODEC_REPO=neuphonic/neucodec-onnx-decoder-int8
VIENEU_CODEC_DEVICE=cpu

# Optional for private HF repos / rate limits
HF_TOKEN=
