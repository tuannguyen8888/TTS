# Demo deployment on Runpod:
# - CPU Pod: backend + dashboard + postgres + redis (docker compose in deploy/)
# - TTS: Runpod Serverless GPU endpoint
# Use with:
# docker compose -f docker-compose.yml -f docker-compose.demo.yml up -d --build

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-demo-password
POSTGRES_DB=tts_saas

BACKEND_PORT=3000
DATABASE_URL=postgresql://postgres:change-me-demo-password@postgres:5432/tts_saas
REDIS_URL=redis://redis:6379

# Demo only (fresh DB): auto-create tables from entities
TYPEORM_SYNCHRONIZE=true

# Backend auth/session
JWT_ACCESS_SECRET=change-me-demo-jwt-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Backend -> TTS (Runpod Serverless)
TTS_PROVIDER=runpod_serverless
RUNPOD_API_KEY=rp_XXXXXXXXXXXXXXXXXXXXXXXX
RUNPOD_SERVERLESS_ENDPOINT_ID=xxxxxxxxxxxxxxxx
RUNPOD_SERVERLESS_BASE_URL=https://api.runpod.ai/v2
RUNPOD_SERVERLESS_TIMEOUT_MS=180000

# Legacy wrapper vars still required by current compose (can be dummy in serverless demo mode)
RUNPOD_HMAC_SECRET_CURRENT=dummy-runpod-hmac-for-demo
RUNPOD_HMAC_SECRET_PREVIOUS=
VPS_HMAC_SECRET_CURRENT=dummy-vps-hmac-for-demo
VPS_HMAC_SECRET_PREVIOUS=
RUNPOD_TTS_BASE_URL=
VPS_CALLBACK_BASE_URL=
RUNPOD_RETRY_ATTEMPTS=3
RUNPOD_RETRY_BASE_DELAY_MS=1000

# Public URLs
DASHBOARD_BASE_URL=https://dashboard.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Optional mail (can keep empty for demo if not testing reset password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
RESET_PASSWORD_TTL_MINUTES=30

# Optional bootstrap super admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-demo-admin-password
