# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tts_saas

# Redis
REDIS_URL=redis://localhost:6379

# Runpod TTS internal API (HTTPS)
RUNPOD_TTS_BASE_URL=https://your-runpod-pod-url.runpod.io
RUNPOD_HMAC_SECRET=your-shared-secret-for-hmac

# VPS callback base (for Runpod to call back)
VPS_CALLBACK_BASE_URL=https://your-vps-domain.com
VPS_HMAC_SECRET=same-as-runpod-or-separate

# JWT (for dashboard auth)
JWT_ACCESS_SECRET=your-jwt-access-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# App URL (for reset password link)
DASHBOARD_BASE_URL=http://localhost:3001

# SMTP (forgot/reset password)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_SECURE=false
SMTP_FROM="VieNeu TTS <no-reply@your-domain.com>"
RESET_PASSWORD_TTL_MINUTES=30

# Super admin (global system manager)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
