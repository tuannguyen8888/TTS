# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tts_saas

# Redis
REDIS_URL=redis://localhost:6379

# Runpod TTS internal API (HTTPS)
RUNPOD_TTS_BASE_URL=https://your-runpod-pod-url.runpod.io
RUNPOD_HMAC_SECRET_CURRENT=your-shared-secret-for-hmac
# Optional fallback during key rotation (legacy support):
# RUNPOD_HMAC_SECRET=old-shared-secret
RUNPOD_RETRY_ATTEMPTS=3
RUNPOD_RETRY_BASE_DELAY_MS=1000

# TTS provider: runpod_wrapper (default) | runpod_serverless
TTS_PROVIDER=runpod_wrapper

# Runpod Serverless (demo mode / alternative provider)
RUNPOD_API_KEY=
RUNPOD_SERVERLESS_ENDPOINT_ID=
RUNPOD_SERVERLESS_BASE_URL=https://api.runpod.ai/v2
RUNPOD_SERVERLESS_TIMEOUT_MS=180000

# VPS callback base (for Runpod to call back)
VPS_CALLBACK_BASE_URL=https://your-vps-domain.com
VPS_HMAC_SECRET_CURRENT=same-as-runpod-or-separate
# Optional previous key accepted during rotation:
VPS_HMAC_SECRET_PREVIOUS=
# Optional fallback for legacy config:
# VPS_HMAC_SECRET=old-secret

# JWT (for dashboard auth)
JWT_ACCESS_SECRET=your-jwt-access-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# App URL (for reset password link)
DASHBOARD_BASE_URL=http://localhost:3001

# SMTP (forgot/reset password)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_SECURE=false
SMTP_FROM="VieNeu TTS <no-reply@your-domain.com>"
RESET_PASSWORD_TTL_MINUTES=30

# Super admin (global system manager)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
